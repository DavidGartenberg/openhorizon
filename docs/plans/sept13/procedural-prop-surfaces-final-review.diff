+  const hinge=tier.userData.hinge as THREE.Object3D
+  hinge.position.y-=.1;tier.updateWorldMatrix(true,false)
+  expect(Math.max(...escape()),`${id} ${side}: displaced board below well`).toBeGreaterThan(.04)
+ }
+})
